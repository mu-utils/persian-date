{
  "name": "@mu-utils/persian-date",
  "version": "1.1.0",
  "description": "A lightweight, accurate Persian (Jalali) date library extending native Date with first-class Day.js plugin support.",
  "main": "dist/bundle.min.cjs.js",
  "module": "dist/bundle.min.esm.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu-utils/persian-date.git"
  },
  "scripts": {
    "start": "npm run watch",
    "start:demo": "cd ./demo && npm run watch",
    "test": "jest",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "demo": "ts-node demo/index.ts",
    "prepublishOnly": "npm run build",
    "postpublish": "git push && git push --tags"
  },
  "keywords": [
    "persian",
    "jalali",
    "shamsi",
    "date",
    "persian-date",
    "dayjs",
    "dayjs-plugin",
    "jalaliday",
    "calendar",
    "iran",
    "hijri-shamsi"
  ],
  "license": "ISC",
  "peerDependencies": {
    "dayjs": ">=1.10.0"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^29.5.12",
    "dayjs": "^1.11.23",
    "jest": "^29.7.0",
    "rollup": "^4.21.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-watch": "^1.0.4",
    "ts-jest": "^29.2.4",
    "typescript": "^5.6.2"
  },
  "files": [
    "dist/"
  ]
}
