{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@mu-utils/persian-date": ["src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__tests__/*", "demo"]
}
